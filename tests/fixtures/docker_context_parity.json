  "ignoreContexts": [
    {
      "name": "no-patterns",
      "dockerignore": "",
      "files": [".dockerignore", ".env", "README.md", "app/main.py"],
      "expectedEntries": [".dockerignore", ".env", "README.md", "app", "app/main.py"]
    },
    {
      "name": "root-ignored-directories",
      "dockerignore": "node_modules\n.git\n",
      "files": [".dockerignore", ".git/config", "app/main.py", "node_modules/pkg/index.js"],
      "expectedEntries": [".dockerignore", "app", "app/main.py"]
    },
    {
      "name": "negated-descendant",
      "dockerignore": "node_modules\n!node_modules/keep.js\n",
      "files": [".dockerignore", "node_modules/drop.js", "node_modules/keep.js"],
      "expectedEntries": [".dockerignore", "node_modules", "node_modules/keep.js"]
    },
    {
      "name": "ordered-negation",
      "dockerignore": "*.log\n!important.log\n",
      "files": [".dockerignore", "data.txt", "important.log", "logs/a.log"],
      "expectedEntries": [".dockerignore", "data.txt", "important.log", "logs", "logs/a.log"]
    },
    {
      "name": "root-anchored-pattern",
      "dockerignore": "/root.txt\n",
      "files": [".dockerignore", "nested/root.txt", "root.txt"],
      "expectedEntries": [".dockerignore", "nested", "nested/root.txt"]
    },
    {
      "name": "trailing-slash-normalization",
      "dockerignore": "cache/\n",
      "files": [".dockerignore", "cache/root.bin", "nested/cache/nested.bin"],
      "expectedEntries": [".dockerignore", "nested", "nested/cache", "nested/cache/nested.bin"]
    },
    {
      "name": "doublestar-directory",
      "dockerignore": "**/tmp/**\n",
      "files": [".dockerignore", "tmp/root.bin", "a/tmp/nested.bin", "a/tmpkeep/kept.bin"],
      "expectedEntries": [".dockerignore", "a", "a/tmp", "a/tmpkeep", "a/tmpkeep/kept.bin", "tmp"]
    },
    {
      "name": "negation-under-unrelated-directory",
      "dockerignore": "vendor\n!src/keep.py\n",
      "files": [".dockerignore", "src/drop.py", "src/keep.py", "vendor/pkg/file.py"],
      "expectedEntries": [".dockerignore", "src", "src/drop.py", "src/keep.py"]
    },
    {
      "name": "wildcard-negation",
      "dockerignore": "**/*.py\n!src/**/keep.py\n",
      "files": [".dockerignore", "README.md", "other/drop.py", "src/a/drop.py", "src/a/keep.py"],
      "expectedEntries": [".dockerignore", "README.md", "other", "src", "src/a", "src/a/keep.py"]
    },
    {
      "name": "character-class",
      "dockerignore": "logs/[0-9].log\n",
      "files": [".dockerignore", "logs/1.log", "logs/a.log", "logs/10.log"],
      "expectedEntries": [".dockerignore", "logs", "logs/10.log", "logs/a.log"]
    },
    {
      "name": "trim-and-clean-patterns",
      "dockerignore": "  /build/../node_modules/  \n",
      "files": [".dockerignore", "node_modules/drop.js", "src/main.js"],
      "expectedEntries": [".dockerignore", "src", "src/main.js"]
    },
    {
      "name": "leading-space-hash-is-literal",
      "dockerignore": " #literal\n# comment\n",
      "files": ["#literal", ".dockerignore", "kept.txt"],
      "expectedEntries": [".dockerignore", "kept.txt"]
    },
    {
      "name": "nested-bare-name-is-not-root-name",
      "dockerignore": "generated\n",
      "files": [".dockerignore", "generated/root.txt", "src/generated/nested.txt"],
      "expectedEntries": [".dockerignore", "src", "src/generated", "src/generated/nested.txt"]
    },
    {
      "name": "sparse-nested-file",
      "dockerignore": "",
      "sources": ["src/app/main.py"],
      "files": [".dockerignore", "README.md", "src/app/main.py", "src/other.py"],
      "expectedEntries": ["src", "src/app", "src/app/main.py"]
    },
    {
      "name": "sparse-directory",
      "dockerignore": "src/drop.py\n",
      "sources": ["src"],
      "files": [".dockerignore", "README.md", "src/drop.py", "src/keep.py", "src/nested/data.txt"],
      "expectedEntries": ["src", "src/keep.py", "src/nested", "src/nested/data.txt"]
    },
    {
      "name": "sparse-leaf-symlink",
      "dockerignore": "",
      "sources": ["link.txt"],
      "files": [".dockerignore", "target.txt", "unrelated.txt"],
      "symlinks": [{"path": "link.txt", "target": "target.txt"}],
      "expectedEntries": ["link.txt", "target.txt"]
    },
    {
      "name": "sparse-intermediate-symlink",
      "dockerignore": "",
      "sources": ["alias/data.txt"],
      "files": [".dockerignore", "real/data.txt", "real/other.txt", "unrelated.txt"],
      "symlinks": [{"path": "alias", "target": "real"}],
      "expectedEntries": ["alias", "real", "real/data.txt"]
    },
    {
      "name": "sparse-symlink-cycle",
      "dockerignore": "",
      "sources": ["first"],
      "files": [".dockerignore", "unrelated.txt"],
      "symlinks": [
        {"path": "first", "target": "second"},
        {"path": "second", "target": "first"}
      ],
      "expectedEntries": ["first", "second"]
    },
    {
      "name": "sparse-broken-symlink",
      "dockerignore": "",
      "sources": ["broken.txt"],
      "files": [".dockerignore", "unrelated.txt"],
      "symlinks": [{"path": "broken.txt", "target": "missing.txt"}],
      "expectedEntries": ["broken.txt"]
    },
    {
      "name": "sparse-symlink-target-is-ignored",
      "dockerignore": "target.txt\n",
      "sources": ["link.txt"],
      "files": [".dockerignore", "target.txt", "unrelated.txt"],
      "symlinks": [{"path": "link.txt", "target": "target.txt"}],
      "expectedEntries": ["link.txt"]
    },
    {
      "name": "sparse-parent-relative-symlink",
      "dockerignore": "",
      "sources": ["nested/link.txt"],
      "files": [".dockerignore", "target.txt", "unrelated.txt"],
      "symlinks": [{"path": "nested/link.txt", "target": "../target.txt"}],
      "expectedEntries": ["nested", "nested/link.txt", "target.txt"]
    },
    {
      "name": "sparse-directory-symlink",
      "dockerignore": "real/drop.txt\n",
      "sources": ["alias"],
      "files": [".dockerignore", "real/drop.txt", "real/keep.txt", "real/nested/data.txt", "unrelated.txt"],
      "symlinks": [{"path": "alias", "target": "real"}],
      "expectedEntries": ["alias", "real", "real/keep.txt", "real/nested", "real/nested/data.txt"]
    },
    {
      "name": "unix-backslash-filename-is-not-a-separator",
      "dockerignore": "foo/bar\n",
      "files": [".dockerignore", "foo/bar", "foo\\bar"],
      "expectedEntries": [".dockerignore", "foo", "foo\\bar"]
    }
  ]
}
